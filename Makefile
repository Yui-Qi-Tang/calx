.PHONY: verify fmt-check error-check race build
fmt-check:
	@files=$$(gofmt -l automaton digest sat finite incidence internal cmd examples); if test -n "$$files"; then echo "$$files"; exit 1; fi
error-check:
	go run github.com/kisielk/errcheck@v1.30.0 -blank -asserts -excludeonly -ignore 'fmt:a^' -tags resolverintegration ./automaton/... ./cmd/... ./digest/... ./finite/... ./incidence/... ./internal/... ./sat/... ./examples/...
verify: fmt-check error-check
	go test -count=1 ./...
	go vet ./...
	go build ./...
race:
	go test -race -p 1 -count=1 ./...
build:
	go build -o bin/calx ./cmd/calx
