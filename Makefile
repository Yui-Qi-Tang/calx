.PHONY: verify fmt-check race build
fmt-check:
	@files=$$(gofmt -l sat finite incidence internal cmd); if test -n "$$files"; then echo "$$files"; exit 1; fi
verify: fmt-check
	go test -count=1 ./...
	go vet ./...
	go build ./...
race:
	go test -race -p 1 -count=1 ./...
build:
	go build -o bin/calx ./cmd/calx
